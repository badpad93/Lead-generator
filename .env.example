# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_SITE_URL=https://vendingconnector.com

# Apify
APIFY_API_TOKEN=your-apify-api-token
APIFY_ACTOR_ID=your-username~lead-generator-worker

# Stripe (subscription paywall — $19.99/mo)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Stripe Connect (marketplace payouts — separate platform account)
STRIPE_CONNECT_SECRET_KEY=sk_live_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Cron security
CRON_SECRET=your-random-secret-string

# Resend (transactional email — receipt + lead details after Stripe checkout)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@yourverifieddomain.com

# PandaDoc (e-signature workflows)
PANDADOC_API_KEY=your-pandadoc-api-key
PANDADOC_WEBHOOK_SECRET=your-pandadoc-webhook-secret

# PayPal (payment collection for pipeline steps)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_MODE=sandbox

# Coffee storefronts
# NEXT_PUBLIC_APP_URL is used by outgoing storefront emails for
# absolute invitation + storefront URLs. Optional; falls back to
# the request origin. STOREFRONT_FROM_EMAIL overrides FROM_EMAIL
# for storefront-specific mail so branded receipts can be sent
# from a different verified address.
NEXT_PUBLIC_APP_URL=https://vendingconnector.com
STOREFRONT_FROM_EMAIL=orders@vendingconnector.com

# QBO accounting refs used by the storefront QB helper. Fill in
# after running the "Chart of accounts" one-time setup in QBO.
# QB_RESALE_TAX_EXEMPTION_REASON_ID is the "Resale" exemption id
# from QBO Sales Tax settings.
QB_RESALE_TAX_EXEMPTION_REASON_ID=5
QB_STOREFRONT_INCOME_ACCOUNT_ID=
QB_STOREFRONT_ASSET_ACCOUNT_ID=
QB_STOREFRONT_EXPENSE_ACCOUNT_ID=

# Google Cloud (Lead Generator — project: projectleadgenvendcon)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-static-api-key
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
