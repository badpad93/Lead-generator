{
  "name": "vending-connector",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.11.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:prune": "eslint . --prune-suppressions --max-warnings=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint:strict && pnpm typecheck && pnpm test",
    "preflight": "pnpm check && pnpm build",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "googleapis": "^176.0.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
